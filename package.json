{
  "name": "numlens",
  "version": "0.1.0",
  "private": true,
  "description": "Worldwide phone number intelligence - validation, line type and carrier estimates without storing anything.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx server/index.ts",
    "lint": "oxlint src server",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "phone",
    "carrier",
    "lookup",
    "libphonenumber",
    "hono",
    "react"
  ],
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "hono": "^4.13.19",
    "libphonenumber-js": "^1.13.16",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}

